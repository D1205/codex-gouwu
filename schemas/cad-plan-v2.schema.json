{
  "$defs": {
    "Baseline": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "semantic_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Semantic Hash",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "semantic_hash"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "Feature": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,59}$",
          "title": "Id",
          "type": "string"
        },
        "operation": {
          "enum": [
            "add",
            "cut"
          ],
          "title": "Operation",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Start"
        },
        "depth": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Depth"
        },
        "pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pattern"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "operation",
        "profile",
        "start",
        "depth",
        "pattern"
      ],
      "title": "Feature",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "op": {
          "enum": [
            "create_plate",
            "create_bracket",
            "create_box",
            "create_features",
            "rebuild",
            "measure",
            "save",
            "reopen",
            "export",
            "preview"
          ],
          "title": "Op",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "enum": [
                  "step",
                  "stl"
                ],
                "type": "string"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "id",
        "op",
        "parameters"
      ],
      "title": "Operation",
      "type": "object"
    },
    "Pattern": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "circular",
            "linear"
          ],
          "title": "Kind",
          "type": "string"
        },
        "count": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Count"
        },
        "radius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Radius"
        },
        "angle_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Angle Deg"
        },
        "step": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              }
            ]
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Step",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "count",
        "radius",
        "angle_deg",
        "step"
      ],
      "title": "Pattern",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "circle",
            "rectangle",
            "polygon"
          ],
          "title": "Kind",
          "type": "string"
        },
        "center": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              }
            ]
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Center",
          "type": "array"
        },
        "diameter": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Diameter"
        },
        "size": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              }
            ]
          },
          "maxItems": 2,
          "title": "Size",
          "type": "array"
        },
        "points": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                }
              ]
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 512,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "center",
        "diameter",
        "size",
        "points"
      ],
      "title": "Profile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "cad-plan/1",
      "enum": [
        "cad-plan/1",
        "cad-plan/2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
      "title": "Task Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "family": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$",
      "title": "Family",
      "type": "string"
    },
    "scope": {
      "const": "geometry_review",
      "default": "geometry_review",
      "title": "Scope",
      "type": "string"
    },
    "parameters_mm": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Parameters Mm",
      "type": "object"
    },
    "parameter_values": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Parameter Values",
      "type": "object"
    },
    "parameter_units": {
      "additionalProperties": {
        "enum": [
          "mm",
          "deg",
          "count"
        ],
        "type": "string"
      },
      "title": "Parameter Units",
      "type": "object"
    },
    "parameter_bindings": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Parameter Bindings",
      "type": "object"
    },
    "feature_recipe": {
      "items": {
        "$ref": "#/$defs/Feature"
      },
      "title": "Feature Recipe",
      "type": "array"
    },
    "features": {
      "items": {
        "$ref": "#/$defs/Feature"
      },
      "title": "Features",
      "type": "array"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "title": "Operations",
      "type": "array"
    },
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/Baseline"
        },
        {
          "type": "null"
        }
      ]
    },
    "deliverables": {
      "items": {
        "enum": [
          "native",
          "step",
          "preview"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Deliverables",
      "type": "array"
    },
    "hard_constraints_mm": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Hard Constraints Mm",
      "type": "object"
    },
    "tolerance_mm": {
      "exclusiveMinimum": 0,
      "maximum": 0.1,
      "title": "Tolerance Mm",
      "type": "number"
    },
    "semantic_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Semantic Hash",
      "type": "string"
    },
    "rule_set_version": {
      "default": "engineering-rules/1",
      "enum": [
        "engineering-rules/1",
        "engineering-rules/2"
      ],
      "title": "Rule Set Version",
      "type": "string"
    },
    "skill_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Skill Sha256",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "revision",
    "family",
    "parameters_mm",
    "operations",
    "baseline",
    "deliverables",
    "hard_constraints_mm",
    "tolerance_mm",
    "semantic_hash",
    "skill_sha256"
  ],
  "title": "CADPlan",
  "type": "object"
}